# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security (đặt giá trị thật qua biến môi trường hoặc .env local — KHÔNG commit .env)
AGENT_API_KEY=change-me-in-production

# Redis (dùng cho rate limiting & cost guard stateless)
REDIS_URL=redis://localhost:6379/0

# Protection limits
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
